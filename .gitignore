# Dependencies
node_modules/

# Environment
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/

# File storage and database backups (UPLOAD_DIR / BACKUP_DIR default here).
# Runtime artefacts and full DB dumps must never be committed.
storage/
# ...but not source code folders that happen to be called "storage".
!backend/src/**/storage/
uploads/
tmp-test-uploads-*/
backups/
!backend/src/**/backups/
*.dump
*.sql.gz

# Logs
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
