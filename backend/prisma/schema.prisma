  document_removed
  retired
  lost
  assigned
  assignment_ended
  ownership_transferred
  status_changed
  request_approved
  handed_over
  returned
  borrowed_external
  returned_external
  incident_reported
  disposal_requested
  disposed
  stock_received
  stock_issued
  stock_adjusted
