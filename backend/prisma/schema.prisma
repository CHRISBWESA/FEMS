// ---------- Users & Roles ----------

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  password_hash         String
  first_name            String
  last_name             String
  phone                 String?
  gender                String?
  roles                 String[]  @default([])
  permissions           String[]  @default([])
  department_id         String?   @db.Uuid
  fellowship_id         String?   @db.Uuid
  is_active             Boolean   @default(true)
  must_change_password  Boolean   @default(false)
  // Session/credential hardening (Phase 22). token_version is embedded in every token: changing or resetting
  // the password bumps it, which invalidates all tokens issued before (stateless revocation).
  token_version         Int       @default(0)
  password_changed_at   DateTime?
  failed_login_count    Int       @default(0)
  last_failed_login_at  DateTime?
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime?

  member                Member?     @relation("user_member")
  notificationsAsActor  Notification[] @relation("NotificationActor")
  invitationsSent       Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted   Invitation[] @relation("InvitationAcceptedBy")
  recordedAttendances   Attendance[] @relation("recordedAttendances")

  @@index([fellowship_id])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  description    String?
  permissions    String[] @default([])
  is_system_role Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("roles")
}

// A fellowship is a tenant. `status` is the lifecycle (active / suspended); `is_active` is kept in step with it
// for older code and clients (is_active = status is 'active').
enum FellowshipStatus {
  active
  suspended
}

model Fellowship {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  location String?
  description String?

  // The DNS label this fellowship is published at, e.g. `casfeta` for casfeta.example.com. Nullable so existing
  // tenants keep working before the public sites are switched on; a null subdomain simply has no public site yet.
  // The value is a bare label - never a full host and never a leading dot - so the host can be rebuilt whenever
  // the platform's own base domain changes.
  subdomain String? @unique

  // Public sites are opt-in. Nothing a fellowship uploads becomes reachable on the internet until somebody with
  // permission turns this on, so enabling the feature cannot retroactively publish content that was uploaded
  // while it was being built.
  public_site_enabled Boolean @default(false)

  is_active             Boolean          @default(true)
  status                FellowshipStatus @default(active)
  // When the public site was last changed (profile, page copy, subdomain or publication). Read by the sitemap's
  // `lastmod`, so a crawler is not told a page is new every time it looks, nor left thinking nothing ever changes.
  site_updated_at       DateTime?
  suspended_at       DateTime?
  suspended_by       String?          @db.Uuid
  suspension_reason  String?
  created_by         String           @db.Uuid
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  modules            FellowshipModuleSetting[]
  supportGrants      SupportAccessGrant[]
  subscription       SaasSubscription?
  saasInvoices       SaasInvoice[]
  publicProfile      PublicProfile?
  publicPages        PublicPage[]
  publicPosts        PublicPost[]
  publicEnquiries    PublicEnquiry[]
  invitations        Invitation[]

  @@map("fellowships")
}

// Per-tenant module availability. No row means the module is available (so existing tenants are unaffected).
// ---------- Invitations ----------

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

// An invitation for a named person to join a fellowship in a named role.
//
// This replaces the old behaviour of creating six accounts up front and editing their e-mail addresses once the
// real office holders were known. An invitation has no account behind it, cannot be signed in to, and grants
// nothing until it is accepted - so a half-provisioned fellowship has no usable credentials lying around in it.
//
// A high-privilege role may only be invited by somebody holding USER_ROLE_ASSIGN_GOV, checked at BOTH ends: on
// creation and again on acceptance. Checking only on creation would let an invitation outlive the authority that
// made it, so the guard is repeated where the grant actually happens.
model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  fellowship_id String           @db.Uuid
  email         String
  first_name    String
  last_name     String
  phone         String?
  roles         String[]         @default([])
  department_id String?          @db.Uuid
  status        InvitationStatus @default(pending)
  // A single-use, expiring token. Stored hashed, never in the clear, so a database leak does not hand over a
  // working invitation; and the token is single-use, so forwarding a link cannot be used to take over the account.
  token_hash    String           @unique
  expires_at    DateTime
  accepted_at   DateTime?
  accepted_user_id String?        @db.Uuid
  invited_by    String           @db.Uuid
  revoked_by    String?          @db.Uuid
  revoked_at    DateTime?
  // The fellowship's own base domain, so the acceptance link can be built at invite time even if the domain
  // changes before the invitation is used.
  site_host     String?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  fellowship    Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)
  invitedBy     User       @relation("InvitationInvitedBy", fields: [invited_by], references: [id])
  acceptedUser  User?      @relation("InvitationAcceptedBy", fields: [accepted_user_id], references: [id])

  @@index([fellowship_id, status])
  @@index([email, status])
  @@index([expires_at])
  @@map("invitations")
}

model FellowshipModuleSetting {
  fellowship_id  String     @db.Uuid
  module_key     String
  enabled        Boolean    @default(true)
  updated_by     String?    @db.Uuid
  updated_at     DateTime   @updatedAt

  fellowship     Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@id([fellowship_id, module_key])
  @@map("fellowship_module_settings")
}

enum SupportGrantStatus {
  requested
  approved
  denied
  revoked
}

// Scoped, time-boxed, tenant-approved access for platform support staff. It replaces impersonation: a grant
// never lets anyone act as a tenant user, it only unlocks specific read-only diagnostic views.
model SupportAccessGrant {
  id                String              @id @default(uuid()) @db.Uuid
  fellowship_id     String              @db.Uuid
  requested_by      String              @db.Uuid
  reason            String
  scopes            String[]
  duration_minutes  Int
  status            SupportGrantStatus  @default(requested)
  decided_by        String?             @db.Uuid
  decided_at        DateTime?
  expires_at        DateTime?
  revoked_at        DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  fellowship        Fellowship          @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@index([fellowship_id, status])
  @@index([requested_by, status])
  @@map("support_access_grants")
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

enum MemberRegistrationLinkStatus {
  pending
  used
  expired
  cancelled
}

enum MemberVerificationStatus {
  pending
  verified
  rejected
}

// A request to join the platform, submitted by a prospective fellowship owner from the public signup form.
// It exists BEFORE any account does, so it carries its own copy of the contact details rather than a user_id.
// Nothing here grants access: approval is a platform decision that runs the normal onboarding service.
model FellowshipRegistration {
  id                   String             @id @default(uuid()) @db.Uuid
  fellowship_name       String
  location             String?
  description          String?
  contact_first_name   String
  contact_last_name    String
  email                String
  phone                String?
  // A plan code the applicant asked about. Not a foreign key on purpose: a plan may be renamed or retired
  // while a request is waiting, and the request must stay readable either way.
  requested_plan_code  String?
  reason               String?
  status               RegistrationStatus @default(pending)
  reviewed_by          String?            @db.Uuid
  reviewed_at          DateTime?
  decision_note        String?
  // Set once approval has created the fellowship, so a request and its tenant stay linked.
  created_fellowship_id String?           @db.Uuid
  submitted_ip         String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

@@index([status, created_at])
  @@index([email])
  @@index([created_fellowship_id])
  @@map("fellowship_registrations")
}

// A temporary link created by a Secretary for member registration. The link expires after 15 minutes
// and can only be used once. When used, it creates a PendingMemberVerification entry.
model MemberRegistrationLink {
  id                  String                         @id @default(uuid()) @db.Uuid
  fellowship_id       String                         @db.Uuid
  token               String                         @unique @db.Uuid
  created_by          String                         @db.Uuid // Secretary user_id
  status              MemberRegistrationLinkStatus   @default(pending)
  expires_at          DateTime
  used_at             DateTime?
  created_at          DateTime                       @default(now())
  updated_at          DateTime                       @updatedAt

  @@index([fellowship_id, status])
  @@index([token])
  @@map("member_registration_links")
}

// A pending member verification created when a MemberRegistrationLink is used.
// The Secretary must verify/reject/edit the member details before they are added to the fellowship.
model PendingMemberVerification {
  id                  String                       @id @default(uuid()) @db.Uuid
  fellowship_id       String                       @db.Uuid
  link_id             String?                      @db.Uuid
  first_name          String
  last_name           String
  email               String?
  phone               String?
  gender              String?                      // male, female, other
  department_id       String?                      @db.Uuid
  status              MemberVerificationStatus     @default(pending)
  submitted_data      Json                         // Original submitted data for audit
  reviewed_by         String?                      @db.Uuid // Secretary user_id
  reviewed_at         DateTime?
  rejection_reason    String?
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  @@index([fellowship_id, status])
  @@index([link_id])
  @@map("pending_member_verifications")
}

// ---------- Members & Departments ----------

model Member {
  id                         String    @id @default(uuid()) @db.Uuid
  fellowship_id              String?   @db.Uuid
  member_code                String    @unique
  full_name                  String
  phone                      String?
  email                      String?
  gender                     String?
  programme                  String?
  year_of_study              String?
  university                 String?
  expected_graduation_year   Int
  expected_graduation_month  Int
  membership_status          MembershipStatus @default(active)
  status_changed_by          String?   @db.Uuid
  status_changed_at          DateTime?
  department_custom_fields   Json?
  leader_role                String?   // e.g., 'secretary', 'chairperson', 'treasurer', 'assistant_secretary', 'assistant_chairperson', 'department_secretary', 'department_chairperson'
  user_id                    String?   @unique @db.Uuid // Only for leaders who have accounts
  // Shown in the leadership directory (and anywhere a leader is shown); an initials avatar is used without one.
  photo_url                  String?
  created_by                 String    @db.Uuid
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  user                       User?     @relation("user_member", fields: [user_id], references: [id], onDelete: SetNull)
  departmentMemberships      DepartmentMember[]
  departmentLeaderships      DepartmentLeader[]
  contributions              Contribution[]
  attendances                Attendance[]
  youthProfile               YouthProfile?
  guardianOfYouth            YouthGuardian[]
  profile                    MemberProfile?
  membershipHistory          MembershipHistory[]
  groupMemberships           MemberGroupMember[]
  pledges                    ContributionPledge[]
  custodianOfAssets          Asset[]
  leadershipAppointments     LeadershipAppointment[]
  assetLoans                 AssetLoan[]
  coordinatedOpportunities   ServiceOpportunity[]
  serviceAssignments         ServiceAssignment[]

  @@index([fellowship_id])
  @@map("members")
}

model Department {
  id                    String   @id @default(uuid()) @db.Uuid
  // Unique per fellowship, NOT globally: two congregations must both be able to have a "Choir" or a "Media"
  // department. The Secretary of each fellowship owns this list.
  name                  String
  description           String?
  fellowship_id         String?  @db.Uuid
  is_active             Boolean  @default(false)
  custom_fields_schema  Json?
  created_by            String   @db.Uuid
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  members               DepartmentMember[]
  leaders               DepartmentLeader[]
  announcementTargets   DepartmentAnnouncementTarget[]
  youthProfiles         YouthProfile[]
  assets                Asset[]
  serviceOpportunities  ServiceOpportunity[]
  financialAccounts     FinancialAccount[]

  @@index([fellowship_id])
  @@unique([fellowship_id, name], map: "departments_fellowship_id_name_key")
  @@map("departments")
}

model DepartmentMember {
  id                    String    @id @default(uuid()) @db.Uuid
  member_id             String    @db.Uuid
  department_id         String    @db.Uuid
  joined_at             DateTime  @default(now())
  removed               Boolean   @default(false)
  removed_at            DateTime?
  removal_approval_id   String?   @db.Uuid

  member                Member     @relation(fields: [member_id], references: [id], onDelete: Cascade)
  department            Department @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@index([department_id, removed])
  // One row per member per department: leaving sets removed=true and re-joining reactivates the same row.
  @@unique([department_id, member_id])
  @@map("department_members")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([member_id])
}

model DepartmentLeader {
  id                   String    @id @default(uuid()) @db.Uuid
  department_id        String    @db.Uuid
  user_id              String    @db.Uuid
  role_in_department   String
  start_date           DateTime  @default(now())
  end_date             DateTime?
  created_at           DateTime  @default(now())
  fellowship_id        String?   @db.Uuid
  // The registered member who holds the office (leaders are always members; accounts are linked through them).
  member_id            String?   @db.Uuid
  appointed_by         String?   @db.Uuid
  ended_by             String?   @db.Uuid
  end_reason           String?
  // Equal to role_in_department while the appointment is current, NULL once it has ended. The unique index below
  // therefore allows exactly one current Chairperson and one current Secretary per department, while every past
  // appointment stays on record as history.
  active_role          String?

  department           Department @relation(fields: [department_id], references: [id], onDelete: Cascade)
  member               Member?    @relation(fields: [member_id], references: [id], onDelete: SetNull)

  @@index([fellowship_id])
  @@index([user_id])
  @@index([member_id])
  @@unique([department_id, active_role])
  @@map("department_leaders")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([department_id])
}

// ---------- Leadership management ----------
//
// The central record of who holds which office. Appointments made here are written through to where each office
// takes effect (account roles for fellowship officers, department_leaders for department offices, the group leader
// flag for group leaders), and offices changed elsewhere are reconciled back, so every module shows the same current
// leader. Appointments are never deleted: an ended appointment stays as history.

model LeadershipPosition {
  id             String   @id @default(uuid()) @db.Uuid
  // Null for the built-in FEMS offices; a fellowship id for positions that fellowship configured itself.
  fellowship_id  String?  @db.Uuid
  key            String
  name           String
  // fellowship | department | group
  level          String
  // The FEMS role or office this position grants (null for configured positions, which are records only).
  system_role    String?
  is_system      Boolean  @default(false)
  is_active      Boolean  @default(true)
  description    String?
  sort_order     Int      @default(100)
  created_by     String?  @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  appointments   LeadershipAppointment[]

  @@unique([fellowship_id, key])
  @@map("leadership_positions")
}

model LeadershipAppointment {
  id                 String    @id @default(uuid()) @db.Uuid
  fellowship_id      String    @db.Uuid
  position_id        String    @db.Uuid
  // The registered member. Kept even if the member record is later removed (name and number are snapshotted).
  member_id          String?   @db.Uuid
  member_name        String
  member_code        String?
  level              String
  department_id      String?   @db.Uuid
  group_id           String?   @db.Uuid
  appointment_date   DateTime
  term_start         DateTime
  term_end           DateTime?
  // active | suspended | former
  status             String    @default("active")
  // "<fellowship>:<position>:<department, group or fellowship>" while active: one active holder per office.
  active_key         String?   @unique
  ended_at           DateTime?
  // replaced | resigned | term_completed | removed | other
  end_reason         String?
  end_notes          String?
  suspended_at       DateTime?
  suspension_reason  String?
  notes              String?
  appointed_by       String?   @db.Uuid
  ended_by           String?   @db.Uuid
  // leadership (made here) | sync (picked up from a change made in another module) | migration
  source             String    @default("leadership")
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  position           LeadershipPosition @relation(fields: [position_id], references: [id], onDelete: Restrict)
  member             Member?            @relation(fields: [member_id], references: [id], onDelete: SetNull)

  @@index([fellowship_id, status])
  @@index([member_id])
  @@index([position_id])
  @@index([department_id])
  @@index([group_id])
  @@map("leadership_appointments")
}

// ---------- Programmes ----------

model Programme {
  id            String   @id @default(uuid()) @db.Uuid
  // Unique per fellowship, for the same reason departments are: a fellowship's ministries are its own.
  name          String
  description   String?
  fellowship_id String?  @db.Uuid
  created_by    String   @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([fellowship_id])
  @@unique([fellowship_id, name], map: "programmes_fellowship_id_name_key")
  @@map("programmes")
}

// ---------- Activities & Reports ----------

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  date           DateTime
  end_date       DateTime?
  audience_type  AudienceType
  department_id  String?      @db.Uuid
  fellowship_id  String?      @db.Uuid
  specific_group String?
  created_by     String       @db.Uuid
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  // Department activity workflow. Existing and officer-created activities are APPROVED (official) by default.
  status               ActivityStatus @default(APPROVED)
  objectives           String?
  venue                String?
  supporting_info      String?
  attachments          Json           @default("[]")
  submitted_at         DateTime?
  approval_workflow_id String?        @db.Uuid

  attendances    Attendance[]
  serviceShifts  ServiceShift[]

  @@index([fellowship_id])
  @@index([fellowship_id, date])
  @@index([department_id, status])
  @@map("activities")
}

model Attendance {
  id                 String   @id @default(uuid()) @db.Uuid
  activity_id        String   @db.Uuid
  member_id          String?  @db.Uuid
  // Set when the attendee is a youth/child participant tracked via YouthProfile 
  // rather than a full Member record (children often don't have one - see YouthProfile doc 
  // comment). Nullable and additive: every existing Attendance caller is unaffected.
  youth_profile_id   String?  @db.Uuid
  recorded_by_name   String?
  recorded_by_user_id String?  @db.Uuid // Secretary who recorded this attendance
  public_checkin_key  String?       @db.VarChar(300)
  recorded_at        DateTime @default(now())
  is_confirmed       Boolean  @default(true)
  fellowship_id      String?  @db.Uuid

  activity           Activity      @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  member             Member?       @relation(fields: [member_id], references: [id], onDelete: SetNull)
  youthProfile       YouthProfile? @relation(fields: [youth_profile_id], references: [id], onDelete: SetNull)
  recordedBy         User?         @relation("recordedAttendances", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)

  @@index([fellowship_id])
  @@index([activity_id])
  @@index([member_id])
  @@index([youth_profile_id])
  @@map("attendance")
}

model Report {
  id                    String         @id @default(uuid()) @db.Uuid
  department_id         String         @db.Uuid
  fellowship_id         String?        @db.Uuid
  title                 String
  content               String
  attachments           String[]       @default([])
  submitted_by          String         @db.Uuid
  submitted_at          DateTime       @default(now())
  status                ApprovalStatus @default(DRAFT)
  approval_workflow_id  String?        @db.Uuid
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // Structured activity report (department workspace). Older free-text reports leave these empty.
  activity_id           String?        @db.Uuid
  activity_title        String?
  activity_date         DateTime?
  objectives            String?
  participants          Int?
  achievements          String?
  outcomes              String?
  challenges            String?
  recommendations       String?
  photos                Json           @default("[]")
  documents             Json           @default("[]")
  version               Int            @default(1)

  submissions           ReportSubmission[]

  @@index([fellowship_id])
  @@index([department_id, status])
  @@map("reports")
}

// Every submission of a report is kept, so a revised report never overwrites what reviewers saw before.
model ReportSubmission {
  id            String   @id @default(uuid()) @db.Uuid
  report_id     String   @db.Uuid
  fellowship_id String?  @db.Uuid
  version       Int
  data          Json
  submitted_by  String   @db.Uuid
  submitted_at  DateTime @default(now())

  report        Report   @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@unique([report_id, version])
  @@map("report_submissions")
}

model Announcement {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  content        String
  audience_type  AudienceType @default(all_members)
  department_id  String?      @db.Uuid
  fellowship_id  String?      @db.Uuid
  created_by     String       @db.Uuid
  status         ApprovalStatus @default(DRAFT)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  @@index([fellowship_id])
  @@map("announcements")
}

// ---------- Finance ----------

model Contribution {
  id                    String         @id @default(uuid()) @db.Uuid
  // Null for external and anonymous contributors.
  member_id             String?        @db.Uuid
  fellowship_id         String?        @db.Uuid
  amount                Decimal        @db.Decimal(12, 2)
  contribution_type     String
  date                  DateTime
  recorded_by           String         @db.Uuid
  recorded_at           DateTime       @default(now())
  approval_status       ApprovalStatus @default(FINAL_APPROVED)
  approval_workflow_id  String?        @db.Uuid
  campaign_id           String?        @db.Uuid
  category_id           String?        @db.Uuid
  // Receipts reuse the existing documents table; a plain scalar (no FK) like the other audit-style
  // references in this schema, validated at write time.
  receipt_document_id   String?        @db.Uuid
  notes                 String?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // ---- Ledger-backed contributions (finance & projects) ----
  receipt_number        String?
  contributor_type      ContributorType @default(member)
  contributor_name      String?
  contributor_phone     String?
  contributor_email     String?
  payment_method        String?
  payment_reference     String?
  // method + reference, lower-cased: the same payment reference can never be recorded twice in a fellowship.
  payment_dedupe_key    String?
  account_id            String?        @db.Uuid
  // Set for a department's own contribution; null for central fellowship money.
  department_id         String?        @db.Uuid
  pledge_id             String?        @db.Uuid
  // The part of this payment that went towards the pledge; the rest (if any) is an additional contribution.
  pledge_applied        Decimal?       @db.Decimal(12, 2)
  membership_fee_id     String?        @db.Uuid
  attachments           Json           @default("[]")
  // active | reversed. Financial records are never deleted: a mistake is reversed in the ledger.
  status                String         @default("active")
  reversed_at           DateTime?
  reversed_by           String?        @db.Uuid
  reversal_reason       String?

  // A member leaving never deletes the money they gave.
  member                Member?        @relation(fields: [member_id], references: [id], onDelete: SetNull)
  campaign              ContributionCampaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  category              FinanceCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  account               FinancialAccount?     @relation(fields: [account_id], references: [id], onDelete: Restrict)
  allocations           ContributionAllocation[]

  @@unique([fellowship_id, receipt_number])
  @@unique([fellowship_id, payment_dedupe_key])
  @@index([department_id, date])
  @@index([pledge_id])
  @@index([membership_fee_id])
  @@index([account_id])

  @@index([fellowship_id])
  @@index([member_id, date])
  @@index([campaign_id])
  @@map("contributions")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([category_id])
}

model Expense {
  id                    String         @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  amount                Decimal        @db.Decimal(12, 2)
  date                  DateTime
  department_id         String?        @db.Uuid
  fellowship_id         String?        @db.Uuid
  recorded_by           String         @db.Uuid
  purpose               String?
  category_id           String?        @db.Uuid
  receipt_document_id   String?        @db.Uuid
  approval_status       ApprovalStatus @default(DRAFT)
  approval_workflow_id  String?        @db.Uuid
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // ---- Payment and budget tracking. Approved is not paid: payment_status moves to 'paid' only when money leaves an account. ----
  expense_number        String?
  amount_approved       Decimal?       @db.Decimal(12, 2)
  amount_paid           Decimal?       @db.Decimal(12, 2)
  payment_status        String         @default("unpaid")
  project_id            String?        @db.Uuid
  activity_id           String?        @db.Uuid
  budget_id             String?        @db.Uuid
  budget_line_id        String?        @db.Uuid
  payee                 String?
  payment_method        String?
  payment_reference     String?
  account_id            String?        @db.Uuid
  paid_at               DateTime?
  paid_by               String?        @db.Uuid
  // Money already spent before approval (a reimbursement): must carry evidence and be verified before payment.
  already_incurred      Boolean        @default(false)
  verified_at           DateTime?
  verified_by           String?        @db.Uuid
  attachments           Json           @default("[]")
  // The money request this expense pays out (one request, at most one expense).
  money_request_id      String?        @unique @db.Uuid
  campaign_id           String?        @db.Uuid
  reversed_at           DateTime?
  reversed_by           String?        @db.Uuid
  reversal_reason       String?

  category              FinanceCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  account               FinancialAccount? @relation(fields: [account_id], references: [id], onDelete: Restrict)
  campaign              ContributionCampaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@index([fellowship_id])
  @@index([department_id, date])
  @@unique([fellowship_id, expense_number])
  @@index([campaign_id])
  @@index([project_id])
  @@index([budget_id])
  @@map("expenses")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([category_id])
}

model Budget {
  id                    String         @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  amount                Decimal        @db.Decimal(12, 2)
  department_id         String?        @db.Uuid
  fellowship_id         String?        @db.Uuid
  fiscal_year           String
  created_by            String         @db.Uuid
  approval_status       ApprovalStatus @default(DRAFT)
  approval_workflow_id  String?        @db.Uuid
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // ---- Line-item budgets ----
  budget_number         String?
  // annual | department | project | activity | fundraising
  budget_type           String         @default("annual")
  project_id            String?        @db.Uuid
  activity_id           String?        @db.Uuid
  budget_call_id        String?        @db.Uuid
  period_start          DateTime?
  period_end            DateTime?
  version               Int            @default(1)

  lines                 BudgetLineItem[]
  revisions             BudgetRevision[]

  @@index([fellowship_id])
  @@unique([fellowship_id, budget_number])
  @@index([department_id])
  @@index([project_id])
  @@index([budget_call_id])
  @@map("budgets")
}

model MoneyRequest {
  id                    String         @id @default(uuid()) @db.Uuid
  requester_id          String         @db.Uuid
  department_id         String?        @db.Uuid
  fellowship_id         String?        @db.Uuid
  title                 String
  description           String?
  amount                Decimal        @db.Decimal(12, 2)
  purpose               String
  approval_status       ApprovalStatus @default(DRAFT)
  approval_workflow_id  String?        @db.Uuid
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // Department financial request details (department workspace).
  justification         String?
  activity_id           String?        @db.Uuid
  expense_breakdown     Json?
  attachments           Json           @default("[]")
  submitted_at          DateTime?
  request_number            String?
  project_id                String?   @db.Uuid
  budget_id                 String?   @db.Uuid
  budget_line_id            String?   @db.Uuid
  required_date             DateTime?
  preferred_payment_method  String?

  release               MoneyRequestRelease?

  @@index([fellowship_id])
  @@index([department_id])
  @@unique([fellowship_id, request_number])
  @@index([project_id])
  @@map("money_requests")
}

// ---------- Advanced finance (Phase 15) ----------
//
// Extends - never duplicates - the existing Contribution / Expense / Budget / MoneyRequest tables.
// Amounts are Decimal(12,2). Fellowship-scoped like every other entity.

model FinanceCategory {
  id             String                @id @default(uuid()) @db.Uuid
  fellowship_id  String?               @db.Uuid
  kind           FinanceCategoryKind
  name           String
  is_active      Boolean               @default(true)
  created_by     String                @db.Uuid
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  contributions  Contribution[]
  expenses       Expense[]
  income         IncomeRecord[]

  @@unique([fellowship_id, kind, name])
  @@map("finance_categories")
}

model ContributionCampaign {
  id             String         @id @default(uuid()) @db.Uuid
  fellowship_id  String?        @db.Uuid
  name           String
  description    String?
  target_amount  Decimal?       @db.Decimal(12, 2)
  start_date     DateTime
  end_date       DateTime?
  status         CampaignStatus @default(active)
  department_id  String?        @db.Uuid
  created_by     String         @db.Uuid
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  // ---- Fundraising ----
  project_id        String?   @db.Uuid
  budget_breakdown  Json      @default("[]")
  // Unguessable public identifier; the public page shows aggregates only, never contributors.
  public_slug       String?   @unique
  is_public         Boolean   @default(false)
  published_at      DateTime?
  kind              String    @default("event")

  contributions  Contribution[]
  income         IncomeRecord[]
  pledges        ContributionPledge[]
  updates        CampaignUpdate[]
  expenses       Expense[]

  @@unique([fellowship_id, name])
  @@index([project_id])
  @@map("contribution_campaigns")
}

// Income that is not a member contribution (grants, fundraising proceeds, donations, ...).
model IncomeRecord {
  id                   String                @id @default(uuid()) @db.Uuid
  fellowship_id        String?               @db.Uuid
  title                String
  description          String?
  amount               Decimal               @db.Decimal(12, 2)
  date                 DateTime
  source               String?
  category_id          String?               @db.Uuid
  campaign_id          String?               @db.Uuid
  department_id        String?               @db.Uuid
  receipt_document_id  String?               @db.Uuid
  recorded_by          String                @db.Uuid
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  receipt_number       String?
  account_id           String?               @db.Uuid
  project_id           String?               @db.Uuid
  funding_source       String?
  payment_method       String?
  payment_reference    String?
  status               String                @default("active")
  reversed_at          DateTime?
  reversed_by          String?               @db.Uuid
  reversal_reason      String?

  category             FinanceCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  campaign             ContributionCampaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  account              FinancialAccount?     @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([fellowship_id, date])
  @@unique([fellowship_id, receipt_number])
  @@index([project_id])
  @@map("income_records")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([campaign_id])
  @@index([category_id])
}

// A closed period rejects new/edited financial records dated inside it.
model FinancialPeriod {
  id             String    @id @default(uuid()) @db.Uuid
  fellowship_id  String?   @db.Uuid
  name           String
  start_date     DateTime
  end_date       DateTime
  is_closed      Boolean   @default(false)
  closed_by      String?   @db.Uuid
  closed_at      DateTime?
  // year | quarter | month | custom. Closing a year goes through Treasurer -> Secretary -> Chairperson.
  period_type          String    @default("custom")
  closure_status       String?
  closure_workflow_id  String?   @db.Uuid
  reopened_by          String?   @db.Uuid
  reopened_at          DateTime?
  reopen_reason        String?
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([fellowship_id, start_date])
  @@map("financial_periods")
}

// A member's commitment to give. It never creates contributions by itself (nothing records money
// without a human); it is compared against actual contributions for fulfillment reporting.
model ContributionPledge {
  id             String                @id @default(uuid()) @db.Uuid
  fellowship_id  String?               @db.Uuid
  member_id      String?               @db.Uuid
  campaign_id    String?               @db.Uuid
  amount         Decimal               @db.Decimal(12, 2)
  frequency      PledgeFrequency
  start_date     DateTime
  end_date       DateTime?
  is_active      Boolean               @default(true)
  notes          String?
  created_by     String                @db.Uuid
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  // ---- Pledges towards projects and campaigns. A pledge is a promise, never money: payments are contributions. ----
  pledge_number      String?
  contributor_type   ContributorType @default(member)
  contributor_name   String?
  contributor_phone  String?
  project_id         String?   @db.Uuid
  department_id      String?   @db.Uuid
  pledged_at         DateTime?
  due_date           DateTime?
  amount_fulfilled   Decimal   @default(0) @db.Decimal(12, 2)
  status             PledgeStatus @default(pending)
  last_reminded_at   DateTime?

  member         Member?               @relation(fields: [member_id], references: [id], onDelete: SetNull)
  campaign       ContributionCampaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@unique([fellowship_id, pledge_number])
  @@index([project_id])

  @@index([fellowship_id])
  @@index([member_id])
  @@map("contribution_pledges")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([campaign_id])
}

// The disbursement of an approved money request. money_request_id is UNIQUE: the database itself
// guarantees a request can be released at most once, even under concurrent attempts.
model MoneyRequestRelease {
  id                   String       @id @default(uuid()) @db.Uuid
  fellowship_id        String?      @db.Uuid
  money_request_id     String       @unique @db.Uuid
  amount               Decimal      @db.Decimal(12, 2)
  method               String
  reference            String?
  notes                String?
  receipt_document_id  String?      @db.Uuid
  released_by          String       @db.Uuid
  released_at          DateTime     @default(now())
  account_id           String?      @db.Uuid
  expense_id           String?      @db.Uuid

  money_request        MoneyRequest @relation(fields: [money_request_id], references: [id], onDelete: Restrict)

  @@index([fellowship_id, released_at])
  @@map("money_request_releases")
}

// ---------- Accounts, ledger and projects ----------
//
// The ledger is the financial source of truth. Every movement of real money (a contribution received, income, an
// expense paid, a transfer, an opening balance, a reversal or an adjustment) is one immutable ledger_entries row
// against one account. An account's balance changes only together with its ledger entry, in one transaction.
// Corrections are reversals or adjustments; nothing is edited or deleted.

model FinanceSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  fellowship_id               String   @unique @db.Uuid
  currency                    String   @default("TZS")
  receipt_prefix              String   @default("RCT")
  // Department expenses at or above this amount need central approval (Treasurer -> Secretary -> Chairperson).
  major_expense_threshold     Decimal? @db.Decimal(12, 2)
  budget_warning_percent      Int      @default(80)
  financial_year_start_month  Int      @default(1)
  payment_methods             String[] @default(["cash", "bank_transfer", "mobile_money", "cheque", "other"])
  updated_by                  String?  @db.Uuid
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@map("finance_settings")
}

// Per-fellowship, per-year sequence for receipt, expense, request, project and other reference numbers.
model FinanceCounter {
  fellowship_id  String @db.Uuid
  key            String
  year           Int
  value          Int    @default(0)

  @@id([fellowship_id, key, year])
  @@map("finance_counters")
}

model FinancialAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  fellowship_id       String   @db.Uuid
  // Null for a central fellowship account; set for a department's own account.
  department_id       String?  @db.Uuid
  name                String
  account_type        FinancialAccountType
  currency            String   @default("TZS")
  reference           String?
  description         String?
  opening_balance     Decimal  @default(0) @db.Decimal(14, 2)
  // Maintained only by the ledger service, together with each ledger entry.
  balance             Decimal  @default(0) @db.Decimal(14, 2)
  is_default          Boolean  @default(false)
  // "<fellowship>:<department or central>" while the account is its scope's default: one default per scope.
  default_key         String?  @unique
  is_active           Boolean  @default(true)
  last_reconciled_at  DateTime?
  created_by          String   @db.Uuid
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  department          Department?  @relation(fields: [department_id], references: [id], onDelete: Restrict)
  entries             LedgerEntry[]
  transfersOut        FinancialTransfer[] @relation("transfer_from")
  transfersIn         FinancialTransfer[] @relation("transfer_to")
  reconciliations     AccountReconciliation[]
  contributions       Contribution[]
  expenses            Expense[]
  income              IncomeRecord[]

  @@index([fellowship_id, department_id])
  @@map("financial_accounts")
}

model LedgerEntry {
  id                 String          @id @default(uuid()) @db.Uuid
  fellowship_id      String          @db.Uuid
  account_id         String          @db.Uuid
  department_id      String?         @db.Uuid
  project_id         String?         @db.Uuid
  entry_type         LedgerEntryType
  // Signed: money into the account is positive, money out is negative.
  amount             Decimal         @db.Decimal(14, 2)
  balance_after      Decimal         @db.Decimal(14, 2)
  entry_date         DateTime
  // What caused the movement: contribution | income | expense | transfer | account | reconciliation | ...
  source_type        String
  source_id          String          @db.Uuid
  reference          String?
  description        String?
  // Set on primary entries so one source can never be posted twice.
  dedupe_key         String?         @unique
  // A reversal points at the entry it cancels; unique, so an entry can be reversed only once.
  reverses_entry_id  String?         @unique @db.Uuid
  created_by         String          @db.Uuid
  created_at         DateTime        @default(now())

  account            FinancialAccount @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([fellowship_id, entry_date])
  @@index([account_id, entry_date])
  @@index([source_type, source_id])
  @@index([department_id, entry_date])
  @@index([project_id])
  @@map("ledger_entries")
}

// A movement between two accounts. Never income or expense. Transfers between central and department funds need
// Fellowship Secretary and Chairperson approval; transfers between two departments are not allowed.
model FinancialTransfer {
  id                    String    @id @default(uuid()) @db.Uuid
  fellowship_id         String    @db.Uuid
  transfer_number       String
  from_account_id       String    @db.Uuid
  to_account_id         String    @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  transfer_date         DateTime
  reference             String?
  description           String?
  // PENDING | COMPLETED | REJECTED | RETURNED | CANCELLED
  status                String    @default("COMPLETED")
  requires_approval     Boolean   @default(false)
  approval_workflow_id  String?   @db.Uuid
  recorded_by           String    @db.Uuid
  completed_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  fromAccount           FinancialAccount @relation("transfer_from", fields: [from_account_id], references: [id], onDelete: Restrict)
  toAccount             FinancialAccount @relation("transfer_to", fields: [to_account_id], references: [id], onDelete: Restrict)

  @@unique([fellowship_id, transfer_number])
  @@index([from_account_id])
  @@index([to_account_id])
  @@map("financial_transfers")
}

model AccountReconciliation {
  id                   String   @id @default(uuid()) @db.Uuid
  fellowship_id        String   @db.Uuid
  account_id           String   @db.Uuid
  statement_date       DateTime
  statement_balance    Decimal  @db.Decimal(14, 2)
  system_balance       Decimal  @db.Decimal(14, 2)
  difference           Decimal  @db.Decimal(14, 2)
  adjustment_entry_id  String?  @db.Uuid
  notes                String?
  reconciled_by        String   @db.Uuid
  created_at           DateTime @default(now())

  account              FinancialAccount @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([account_id, statement_date])
  @@map("account_reconciliations")
}

model Project {
  id                          String        @id @default(uuid()) @db.Uuid
  fellowship_id               String        @db.Uuid
  project_number              String
  // fellowship: central finances (even when a department coordinates it); department: that department's finances.
  scope                       String        @default("fellowship")
  department_id               String?       @db.Uuid
  coordinating_department_id  String?       @db.Uuid
  name                        String
  purpose                     String
  description                 String?
  project_type                String?
  coordinator_member_id       String?       @db.Uuid
  start_date                  DateTime?
  end_date                    DateTime?
  location                    String?
  budget_amount               Decimal       @default(0) @db.Decimal(14, 2)
  attachments                 Json          @default("[]")
  status                      ProjectStatus @default(DRAFT)
  approval_workflow_id        String?       @db.Uuid
  submitted_at                DateTime?
  approved_at                 DateTime?
  closure_workflow_id         String?       @db.Uuid
  // pending | returned | rejected | approved
  closure_status              String?
  final_report                String?
  // return_to_general_fund | carry_forward
  unspent_disposition         String?
  carry_forward_project_id    String?       @db.Uuid
  closed_at                   DateTime?
  created_by                  String        @db.Uuid
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt

  fundingSources              ProjectFundingSource[]
  allocations                 ContributionAllocation[]
  fundAllocations             ProjectAllocation[]

  @@unique([fellowship_id, project_number])
  @@index([fellowship_id, status])
  @@index([department_id])
  @@map("projects")
}

model ProjectFundingSource {
  id               String   @id @default(uuid()) @db.Uuid
  project_id       String   @db.Uuid
  // contributions | general_fund | grant | sponsorship | fundraising | department | other
  source_type      String
  name             String
  expected_amount  Decimal  @default(0) @db.Decimal(14, 2)
  notes            String?
  created_at       DateTime @default(now())

  project          Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_funding_sources")
}

// How much of one contribution goes to one project. A contribution can be unallocated, go to one project, or be
// split; the active allocations never exceed the contribution. Changing allocations ends the old rows (history).
model ContributionAllocation {
  id               String    @id @default(uuid()) @db.Uuid
  fellowship_id    String    @db.Uuid
  contribution_id  String    @db.Uuid
  project_id       String    @db.Uuid
  amount           Decimal   @db.Decimal(12, 2)
  is_active        Boolean   @default(true)
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now())
  ended_at         DateTime?
  ended_by         String?   @db.Uuid
  end_reason       String?

  contribution     Contribution @relation(fields: [contribution_id], references: [id], onDelete: Restrict)
  project          Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)

  @@index([contribution_id, is_active])
  @@index([project_id, is_active])
  @@map("contribution_allocations")
}

// Internal earmarking of General Fund money for a project, and returns of unspent money at closure. Not income.
model ProjectAllocation {
  id                    String    @id @default(uuid()) @db.Uuid
  fellowship_id         String    @db.Uuid
  allocation_number     String
  project_id            String    @db.Uuid
  // general_fund_allocation | return_to_general_fund | carry_forward_out | carry_forward_in
  kind                  String
  // Signed: positive adds to the project's funds, negative takes from them.
  amount                Decimal   @db.Decimal(14, 2)
  // PENDING | APPROVED | REJECTED | RETURNED | CANCELLED
  status                String    @default("PENDING")
  approval_workflow_id  String?   @db.Uuid
  related_project_id    String?   @db.Uuid
  notes                 String?
  created_by            String    @db.Uuid
  approved_at           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  project               Project   @relation(fields: [project_id], references: [id], onDelete: Restrict)

  @@unique([fellowship_id, allocation_number])
  @@index([project_id])
  @@map("project_allocations")
}

model CampaignUpdate {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String?  @db.Uuid
  campaign_id    String   @db.Uuid
  title          String
  body           String
  is_published   Boolean  @default(true)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())

  campaign       ContributionCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, created_at])
  @@map("campaign_updates")
}

model BudgetLineItem {
  id           String   @id @default(uuid()) @db.Uuid
  budget_id    String   @db.Uuid
  name         String
  category_id  String?  @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  notes        String?
  sort_order   Int      @default(0)
  // A line removed by a revision stays (expenses may point at it) but is no longer part of the budget.
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  budget       Budget   @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@index([budget_id])
  @@map("budget_line_items")
}

model BudgetRevision {
  id                    String         @id @default(uuid()) @db.Uuid
  fellowship_id         String?        @db.Uuid
  budget_id             String         @db.Uuid
  from_version          Int
  reason                String
  proposed_lines        Json
  proposed_amount       Decimal        @db.Decimal(14, 2)
  // The approved version this revision replaced, kept for history once it is applied.
  previous_lines        Json?
  previous_amount       Decimal?       @db.Decimal(14, 2)
  status                ApprovalStatus @default(SUBMITTED)
  approval_workflow_id  String?        @db.Uuid
  created_by            String         @db.Uuid
  applied_at            DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  budget                Budget         @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@index([budget_id])
  @@map("budget_revisions")
}

// The Fellowship Secretary's instruction to departments to submit their annual budgets.
model BudgetCall {
  id               String   @id @default(uuid()) @db.Uuid
  fellowship_id    String   @db.Uuid
  title            String
  fiscal_year      String
  period_start     DateTime
  period_end       DateTime
  instructions     String?
  deadline         DateTime
  all_departments  Boolean  @default(true)
  department_ids   Json     @default("[]")
  // open | closed
  status           String   @default("open")
  created_by       String   @db.Uuid
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([fellowship_id, status])
  @@map("budget_calls")
}

// A department's membership fee or recurring contribution. Payments are contributions with membership_fee_id.
model MembershipFee {
  id                   String       @id @default(uuid()) @db.Uuid
  fellowship_id        String       @db.Uuid
  department_id        String       @db.Uuid
  name                 String
  amount               Decimal      @db.Decimal(12, 2)
  frequency            FeeFrequency
  start_date           DateTime
  end_date             DateTime?
  // Explicit due dates for a custom schedule.
  due_dates            Json         @default("[]")
  // Null means every current member of the department.
  eligible_member_ids  Json?
  allow_partial        Boolean      @default(true)
  is_active            Boolean      @default(true)
  created_by           String       @db.Uuid
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  @@index([department_id, is_active])
  @@map("membership_fees")
}

// ---------- Resources & assets (Phase 16) ----------
//
// Custodians / borrowers are existing Members, ownership is an existing Department, attachments are
// existing documents (by id), acquisition may reference an existing Expense (by id). Nothing here
// duplicates people, departments, documents or accounting.

model AssetCategory {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String?  @db.Uuid
  name           String
  description    String?
  is_active      Boolean  @default(true)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  assets         Asset[]

  @@unique([fellowship_id, name])
  @@map("asset_categories")
}

model AssetLocation {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String?  @db.Uuid
  name           String
  description    String?
  is_active      Boolean  @default(true)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  assets         Asset[]

  @@unique([fellowship_id, name])
  @@map("asset_locations")
}

model Asset {
  id                    String         @id @default(uuid()) @db.Uuid
  fellowship_id         String?        @db.Uuid
  asset_tag             String
  name                  String
  description           String?
  category_id           String?        @db.Uuid
  location_id           String?        @db.Uuid
  serial_number         String?
  acquisition_date      DateTime?
  acquisition_cost      Decimal?       @db.Decimal(12, 2)
  // Optional pointer to the existing Expense that paid for it (validated, same fellowship). No accounting is duplicated.
  acquisition_expense_id String?       @db.Uuid
  condition             AssetCondition @default(good)
  status                AssetStatus    @default(available)
  // Consumable stock (paper, cleaning supplies): counted, never checked out.
  is_consumable         Boolean        @default(false)
  quantity              Int            @default(1)
  reorder_level         Int?
  owning_department_id  String?        @db.Uuid
  custodian_member_id   String?        @db.Uuid
  notes                 String?
  retired_at            DateTime?
  retired_reason        String?
  created_by            String         @db.Uuid
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  // ---- Ownership and accountability (resource management) ----
  // owning_department_id is the OWNER for department-owned resources (and the receiving department for donations
  // or borrowings made by a department). assigned_department_id is who currently USES a fellowship-owned asset.
  ownership_type        AssetOwnership @default(fellowship)
  assigned_department_id String?       @db.Uuid
  acquisition_method    String?
  acquisition_source    String?
  estimated_value       Decimal?       @db.Decimal(12, 2)
  donor_name            String?
  donor_contact         String?
  donation_date         DateTime?
  // Borrowed from outside the fellowship.
  external_owner_name     String?
  external_owner_contact  String?
  borrowed_on             DateTime?
  expected_return_date    DateTime?
  actual_return_date      DateTime?
  condition_received      AssetCondition?
  condition_returned      AssetCondition?
  last_inspected_at     DateTime?
  unit                  String?
  storage_location      String?
  photos                Json           @default("[]")
  attachments           Json           @default("[]")
  disposed_at           DateTime?
  disposal_method       String?

  category              AssetCategory?  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  location              AssetLocation?  @relation(fields: [location_id], references: [id], onDelete: SetNull)
  owning_department     Department?     @relation(fields: [owning_department_id], references: [id], onDelete: SetNull)
  custodian             Member?         @relation(fields: [custodian_member_id], references: [id], onDelete: SetNull)
  loans                 AssetLoan[]
  maintenance           AssetMaintenance[]
  history               AssetHistory[]
  documents             AssetDocument[]

  @@unique([fellowship_id, asset_tag])
  @@index([fellowship_id, status])
  @@index([owning_department_id])
  @@index([assigned_department_id])
  @@index([fellowship_id, ownership_type])
  @@index([custodian_member_id])
  @@index([category_id])
  @@index([location_id])
  @@map("assets")
}

// A temporary loan of an asset to a member. At most one OPEN loan per asset is guaranteed by flipping
// asset.status available -> checked_out with a conditional write (the flip is the mutex).
model AssetLoan {
  id               String          @id @default(uuid()) @db.Uuid
  fellowship_id    String?         @db.Uuid
  asset_id         String          @db.Uuid
  member_id        String          @db.Uuid
  checked_out_at   DateTime        @default(now())
  due_date         DateTime?
  checked_in_at    DateTime?
  condition_out    AssetCondition
  condition_in     AssetCondition?
  checked_out_by   String          @db.Uuid
  checked_in_by    String?         @db.Uuid
  notes            String?

  asset            Asset           @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  member           Member          @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@index([asset_id, checked_in_at])
  @@index([member_id, checked_in_at])
  @@index([fellowship_id, due_date])
  @@map("asset_loans")
}

model AssetMaintenance {
  id                String            @id @default(uuid()) @db.Uuid
  fellowship_id     String?           @db.Uuid
  asset_id          String            @db.Uuid
  type              MaintenanceType
  status            MaintenanceStatus @default(scheduled)
  scheduled_for     DateTime
  started_at        DateTime?
  completed_at      DateTime?
  description       String
  performed_by      String?
  cost              Decimal?          @db.Decimal(12, 2)
  condition_after   AssetCondition?
  notes             String?
  // ---- Repairs reported and approved through resource management ----
  reported_by       String?           @db.Uuid
  department_id     String?           @db.Uuid
  technician        String?
  estimated_cost    Decimal?          @db.Decimal(12, 2)
  // The finance expense that pays for the repair (one expense, never duplicated).
  expense_id        String?           @db.Uuid
  attachments       Json              @default("[]")
  approved_by       String?           @db.Uuid
  approved_at       DateTime?
  created_by        String            @db.Uuid
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  asset             Asset             @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id, status])
  @@index([fellowship_id, status, scheduled_for])
  @@map("asset_maintenance")
}

// Append-only timeline. There is deliberately no update/delete API for it. References are plain
// scalars (no FK) so history survives removal of the records it mentions.
model AssetHistory {
  id                  String         @id @default(uuid()) @db.Uuid
  fellowship_id       String?        @db.Uuid
  asset_id            String         @db.Uuid
  event_type          AssetEventType
  actor_id            String?        @db.Uuid
  member_id           String?        @db.Uuid
  from_department_id  String?        @db.Uuid
  to_department_id    String?        @db.Uuid
  from_location_id    String?        @db.Uuid
  to_location_id      String?        @db.Uuid
  from_value          String?
  to_value            String?
  note                String?
  occurred_at         DateTime       @default(now())

  asset               Asset          @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id, occurred_at])
  @@index([fellowship_id, occurred_at])
  @@map("asset_history")
}

model AssetDocument {
  id            String   @id @default(uuid()) @db.Uuid
  fellowship_id String?  @db.Uuid
  asset_id      String   @db.Uuid
  document_id   String   @db.Uuid
  label         String?
  attached_by   String   @db.Uuid
  created_at    DateTime @default(now())

  asset         Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, document_id])
  @@map("asset_documents")
}

// ---------- Resource management: assignments, transfers, requests, incidents, stock ----------

model ResourceSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  fellowship_id             String   @unique @db.Uuid
  tag_prefix                String   @default("AST")
  units                     String[] @default(["piece", "set", "box", "pack", "ream", "litre", "kg", "metre"])
  maintenance_categories    String[] @default(["repair", "service", "inspection", "cleaning"])
  // Disposals of resources worth at least this much always need the Fellowship Secretary and Chairperson.
  major_disposal_value      Decimal? @db.Decimal(12, 2)
  low_stock_notifications   Boolean  @default(true)
  return_reminder_days      Int      @default(2)
  updated_by                String?  @db.Uuid
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@map("resource_settings")
}

// Custody of a fellowship-owned asset by a department. Never an ownership change. At most one open assignment per
// asset (active_key = asset id while open, null once ended).
model AssetAssignment {
  id                    String          @id @default(uuid()) @db.Uuid
  fellowship_id         String          @db.Uuid
  asset_id              String          @db.Uuid
  department_id         String          @db.Uuid
  responsible_member_id String?         @db.Uuid
  from_location_id      String?         @db.Uuid
  to_location_id        String?         @db.Uuid
  handed_over_at        DateTime        @default(now())
  condition_at_handover AssetCondition
  authorized_by         String          @db.Uuid
  notes                 String?
  active_key            String?         @unique
  ended_at              DateTime?
  ended_by              String?         @db.Uuid
  condition_at_return   AssetCondition?
  end_notes             String?

  @@index([asset_id, handed_over_at])
  @@index([department_id, ended_at])
  @@map("asset_assignments")
}

// Moving a resource: between locations, between custodians, or a change of OWNER. Ownership changes of a
// department's resource, or into/out of the fellowship's ownership, need approval and are never silent.
model AssetTransfer {
  id                     String          @id @default(uuid()) @db.Uuid
  fellowship_id          String          @db.Uuid
  transfer_number        String
  asset_id               String          @db.Uuid
  // location | ownership
  kind                   String
  from_ownership         AssetOwnership
  to_ownership           AssetOwnership
  from_department_id     String?         @db.Uuid
  to_department_id       String?         @db.Uuid
  from_location_id       String?         @db.Uuid
  to_location_id         String?         @db.Uuid
  from_custodian_id      String?         @db.Uuid
  to_custodian_id        String?         @db.Uuid
  transfer_date          DateTime
  reason                 String
  condition_before       AssetCondition
  condition_after        AssetCondition?
  // PENDING | COMPLETED | REJECTED | RETURNED | CANCELLED
  status                 String          @default("PENDING")
  approval_workflow_id   String?         @db.Uuid
  initiated_by           String          @db.Uuid
  approved_by            String?         @db.Uuid
  completed_at           DateTime?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  @@unique([fellowship_id, transfer_number])
  @@index([asset_id, created_at])
  @@map("asset_transfers")
}

// A request to use (borrow / book) a resource for an activity or project. Approval by the resource's manager;
// availability is checked so the same resource is never booked twice for overlapping dates.
model ResourceRequest {
  id                   String          @id @default(uuid()) @db.Uuid
  fellowship_id        String          @db.Uuid
  request_number       String
  asset_id             String          @db.Uuid
  requester_user_id    String          @db.Uuid
  // The department asking (null = a central/fellowship request).
  department_id        String?         @db.Uuid
  borrower_member_id   String?         @db.Uuid
  activity_id          String?         @db.Uuid
  project_id           String?         @db.Uuid
  quantity             Int             @default(1)
  purpose              String
  needed_from          DateTime
  needed_until         DateTime
  location             String?
  supporting_info      String?
  // PENDING | APPROVED | REJECTED | CANCELLED | ISSUED | PARTIALLY_RETURNED | RETURNED
  status               String          @default("PENDING")
  decided_by           String?         @db.Uuid
  decided_at           DateTime?
  decision_note        String?
  issued_at            DateTime?
  issued_by            String?         @db.Uuid
  condition_out        AssetCondition?
  quantity_returned    Int             @default(0)
  returned_at          DateTime?
  received_by          String?         @db.Uuid
  condition_in         AssetCondition?
  return_notes         String?
  return_evidence      Json            @default("[]")
  last_reminded_at     DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  @@unique([fellowship_id, request_number])
  @@index([asset_id, status, needed_from])
  @@index([fellowship_id, status])
  @@index([department_id, status])
  @@map("resource_requests")
}

// Loss, damage, missing items, unusable resources and disposals. A disposal never deletes the asset.
model AssetIncident {
  id                    String    @id @default(uuid()) @db.Uuid
  fellowship_id         String    @db.Uuid
  incident_number       String
  asset_id              String    @db.Uuid
  // lost | damaged | missing | unusable | disposal
  incident_type         String
  description           String
  occurred_at           DateTime
  reported_by           String    @db.Uuid
  department_id         String?   @db.Uuid
  investigation_notes   String?
  // repair | write_off | dispose | recover | none
  proposed_action       String
  disposal_method       String?
  attachments           Json      @default("[]")
  // OPEN | PENDING_APPROVAL | APPROVED | REJECTED | RETURNED | CLOSED
  status                String    @default("OPEN")
  approval_workflow_id  String?   @db.Uuid
  outcome               String?
  closed_at             DateTime?
  closed_by             String?   @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@unique([fellowship_id, incident_number])
  @@index([asset_id, created_at])
  @@index([fellowship_id, status])
  @@map("asset_incidents")
}

// Every change to a consumable item's quantity. The item's quantity changes only together with its movement.
model StockMovement {
  id               String   @id @default(uuid()) @db.Uuid
  fellowship_id    String   @db.Uuid
  asset_id         String   @db.Uuid
  // received | issued | adjusted | transfer_out | transfer_in
  kind             String
  quantity         Int
  balance_after    Int
  department_id    String?  @db.Uuid
  member_id        String?  @db.Uuid
  related_asset_id String?  @db.Uuid
  reference        String?
  reason           String?
  created_by       String   @db.Uuid
  created_at       DateTime @default(now())

  @@index([asset_id, created_at])
  @@index([fellowship_id, created_at])
  @@map("stock_movements")
}

// ---------- Volunteer & service management (Phase 17) ----------
// Volunteering reuses Member (who), Department (scope), Activity (optional event link) and the notification
// engine. It only adds what did not exist: configurable roles, opportunities, dated shifts and assignments.

enum ServiceOpportunityStatus {
  draft
  open
  closed
  cancelled
}

enum ServiceShiftStatus {
  scheduled
  cancelled
}

enum ServiceAssignmentStatus {
  applied
  confirmed
  rejected
  withdrawn
  cancelled
  attended
  no_show
}

model ServiceRole {
  id               String    @id @default(uuid()) @db.Uuid
  fellowship_id    String?   @db.Uuid
  name             String
  description      String?
  required_skills  String[]  @default([])
  is_active        Boolean   @default(true)
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  shifts           ServiceShift[]

  @@unique([fellowship_id, name])
  @@map("service_roles")
}

model ServiceOpportunity {
  id                     String                    @id @default(uuid()) @db.Uuid
  fellowship_id          String?                   @db.Uuid
  department_id          String?                   @db.Uuid
  title                  String
  description            String?
  location               String?
  coordinator_member_id  String?                   @db.Uuid
  status                 ServiceOpportunityStatus  @default(draft)
  created_by             String                    @db.Uuid
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt

  department             Department?               @relation(fields: [department_id], references: [id], onDelete: SetNull)
  coordinator            Member?                   @relation(fields: [coordinator_member_id], references: [id], onDelete: SetNull)
  shifts                 ServiceShift[]

  @@index([fellowship_id, status])
  @@index([department_id])
  @@index([coordinator_member_id])
  @@map("service_opportunities")
}

model ServiceShift {
  id              String             @id @default(uuid()) @db.Uuid
  fellowship_id   String?            @db.Uuid
  opportunity_id  String             @db.Uuid
  role_id         String?            @db.Uuid
  starts_at       DateTime
  ends_at         DateTime
  location        String?
  capacity        Int                @default(1)
  activity_id     String?            @db.Uuid
  status          ServiceShiftStatus @default(scheduled)
  notes           String?
  created_by      String             @db.Uuid
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  opportunity     ServiceOpportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)
  role            ServiceRole?       @relation(fields: [role_id], references: [id], onDelete: SetNull)
  activity        Activity?          @relation(fields: [activity_id], references: [id], onDelete: SetNull)
  assignments     ServiceAssignment[]

  @@index([opportunity_id, starts_at])
  @@index([fellowship_id, starts_at])
  @@map("service_shifts")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([activity_id])
  @@index([role_id])
}

// One row per (shift, member). A withdrawn row may be re-activated; every other terminal state is final,
// so the row doubles as the member's service history.
model ServiceAssignment {
  id             String                   @id @default(uuid()) @db.Uuid
  fellowship_id  String?                  @db.Uuid
  shift_id       String                   @db.Uuid
  member_id      String                   @db.Uuid
  status         ServiceAssignmentStatus
  note           String?
  decided_by     String?                  @db.Uuid
  decided_at     DateTime?
  created_by     String                   @db.Uuid
  created_at     DateTime                 @default(now())
  updated_at     DateTime                 @updatedAt

  shift          ServiceShift             @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  member         Member                   @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@unique([shift_id, member_id])
  @@index([member_id, status])
  @@index([fellowship_id, status])
  @@map("service_assignments")
}

// ---------- SaaS billing (Phase 20) ----------
// FEMS's own subscription billing for a fellowship (the tenant). It is a completely separate domain from the
// fellowship's Finance module: nothing here reads or writes contributions, income, expenses, budgets or
// money requests, and nothing in Finance reads these tables. No card or bank details are ever stored.

enum SaasBillingInterval {
  month
  year
}

// trialing -> active -> past_due -> expired, and cancelled. Access (authentication/RBAC) is never decided
// here; the status only decides which optional modules and limits the plan entitles the fellowship to.
enum SaasSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum SaasInvoiceStatus {
  open
  paid
  void
}

enum SaasWebhookStatus {
  received
  processed
  failed
}

model SaasPlan {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique
  name              String
  description       String?
  price_amount      Decimal             @default(0) @db.Decimal(12, 2)
  currency          String              @default("USD")
  billing_interval  SaasBillingInterval @default(month)
  trial_days        Int                 @default(0)
  // Optional modules included in the plan (see shared/modules/modules.ts) and numeric limits
  // (see shared/billing/plan-config.ts). An absent limit means unlimited.
  modules           String[]            @default([])
  limits            Json                @default("{}")
  is_active         Boolean             @default(true)
  created_by        String              @db.Uuid
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  subscriptions     SaasSubscription[]

  @@map("saas_plans")
}

// One current subscription per fellowship. A fellowship WITHOUT a row is "unmanaged" (no plan enforcement),
// which keeps every tenant that pre-dates billing working exactly as before.
model SaasSubscription {
  id                        String                  @id @default(uuid()) @db.Uuid
  fellowship_id             String                  @unique @db.Uuid
  plan_id                   String                  @db.Uuid
  status                    SaasSubscriptionStatus
  trial_ends_at             DateTime?
  current_period_start      DateTime?
  current_period_end        DateTime?
  cancel_at_period_end      Boolean                 @default(false)
  cancelled_at              DateTime?
  past_due_since            DateTime?
  // Reserved for a payment provider adapter (none is configured): opaque references only.
  provider                  String?
  provider_customer_ref     String?
  provider_subscription_ref String?
  created_by                String                  @db.Uuid
  created_at                DateTime                @default(now())
  updated_at                DateTime                @updatedAt

  fellowship                Fellowship              @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)
  plan                      SaasPlan                @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  invoices                  SaasInvoice[]

  @@index([status])
  @@map("saas_subscriptions")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([plan_id])
}

model SaasInvoice {
  id                String            @id @default(uuid()) @db.Uuid
  number_seq        Int               @unique @default(autoincrement())
  fellowship_id     String            @db.Uuid
  subscription_id   String            @db.Uuid
  // The plan's name and price are copied at issue time so later plan edits never change an invoice.
  plan_name         String
  description       String?
  amount            Decimal           @db.Decimal(12, 2)
  currency          String
  period_start      DateTime
  period_end        DateTime
  status            SaasInvoiceStatus @default(open)
  issued_at         DateTime          @default(now())
  due_at            DateTime
  paid_at           DateTime?
  payment_method    String?
  payment_reference String?
  voided_at         DateTime?
  void_reason       String?
  created_by        String            @db.Uuid

  fellowship        Fellowship        @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)
  subscription      SaasSubscription  @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([fellowship_id, status])
  @@index([status, due_at])
  @@map("saas_invoices")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([subscription_id])
}

// Append-only subscription history.
model SaasSubscriptionEvent {
  id                String                  @id @default(uuid()) @db.Uuid
  fellowship_id     String                  @db.Uuid
  event_type        String
  from_status       SaasSubscriptionStatus?
  to_status         SaasSubscriptionStatus?
  from_plan_id      String?                 @db.Uuid
  to_plan_id        String?                 @db.Uuid
  actor_id          String?                 @db.Uuid
  note              String?
  provider_event_id String?
  occurred_at       DateTime                @default(now())

  @@index([fellowship_id, occurred_at])
  @@map("saas_subscription_events")
}

// Inbound provider notifications. (provider, event_id) is unique, which is what makes processing idempotent.
model SaasWebhookEvent {
  id            String            @id @default(uuid()) @db.Uuid
  provider      String
  event_id      String
  event_type    String
  payload_hash  String
  status        SaasWebhookStatus @default(received)
  error         String?
  fellowship_id String?           @db.Uuid
  received_at   DateTime          @default(now())
  processed_at  DateTime?

  @@unique([provider, event_id])
  @@map("saas_webhook_events")
}

// ---------- Offline attendance sync (Phase 21) ----------
// Idempotency ledger for attendance captured offline. The client gives every recorded check-in a UUID
// ("operation id"); (user_id, op_id) is UNIQUE, so replaying the same sync can never record it twice.
// It carries no names or other personal data.
model AttendanceSyncOp {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  op_id        String   @db.Uuid
  activity_id  String   @db.Uuid
  member_id    String   @db.Uuid
  result       String
  created_at   DateTime @default(now())

  @@unique([user_id, op_id])
  @@index([activity_id])
  @@map("attendance_sync_ops")
}

// ---------- Approval engine ----------

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  workflow_type  String
  entity_id      String         @db.Uuid
  entity_type    String
  fellowship_id  String?        @db.Uuid
  metadata       Json?
  current_stage  Int            @default(0)
  status         ApprovalStatus @default(DRAFT)
  created_by     String         @db.Uuid
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  steps          ApprovalStep[]
  events         ApprovalEvent[]

  @@index([entity_id, workflow_type])
  @@index([fellowship_id])
  @@map("approvals")
}

model ApprovalStep {
  id                 String             @id @default(uuid()) @db.Uuid
  approval_id        String             @db.Uuid
  stage_order        Int
  approver_role      String
  approver_user_id   String?            @db.Uuid
  status             ApprovalStepStatus @default(pending)
  comment            String?
  acted_at           DateTime?
  acted_by           String?            @db.Uuid

  approval           Approval           @relation(fields: [approval_id], references: [id], onDelete: Cascade)

  @@map("approval_steps")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([approval_id])
}

// Append-only history of an approval: every submission, decision and resubmission, with who and when. Steps are
// reset when a returned request is resubmitted; this table is what keeps the earlier reviews.
model ApprovalEvent {
  id             String   @id @default(uuid()) @db.Uuid
  approval_id    String   @db.Uuid
  fellowship_id  String?  @db.Uuid
  action         String   // submitted | approved | rejected | returned | resubmitted | cancelled
  stage_order    Int?
  approver_role  String?
  comment        String?
  actor_user_id  String?  @db.Uuid
  created_at     DateTime @default(now())

  approval       Approval @relation(fields: [approval_id], references: [id], onDelete: Cascade)

  @@index([approval_id, created_at])
  @@map("approval_events")
}

// ---------- Department announcements ----------
//
// Internal announcements from the Fellowship Secretary to department leaders. Kept apart from the public-site
// Announcement model on purpose, so an internal notice can never be published on the fellowship's website.

model DepartmentAnnouncement {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String   @db.Uuid
  title          String
  content        String
  status         String   @default("draft") // draft | published | archived
  target_all     Boolean  @default(false)
  attachments    Json     @default("[]")
  published_at   DateTime?
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  targets        DepartmentAnnouncementTarget[]

  @@index([fellowship_id, status, published_at])
  @@map("department_announcements")
}

model DepartmentAnnouncementTarget {
  id               String                 @id @default(uuid()) @db.Uuid
  announcement_id  String                 @db.Uuid
  department_id    String                 @db.Uuid

  announcement     DepartmentAnnouncement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  department       Department             @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, department_id])
  @@index([department_id])
  @@map("department_announcement_targets")
}

// ---------- IT Content ----------

model DocumentEntity {
  id                    String         @id @default(uuid()) @db.Uuid
  title                 String
  filename              String
  stored_filename       String
  file_size             Int
  mime_type             String
  department_id         String?        @db.Uuid
  fellowship_id         String?        @db.Uuid
  uploaded_by            String        @db.Uuid
  uploaded_at            DateTime      @default(now())
  approval_status       ApprovalStatus @default(DRAFT)
  approval_workflow_id  String?        @db.Uuid
  is_website_content    Boolean        @default(false)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  @@index([fellowship_id])
  @@map("documents")
}

model Comment {
  id           String   @id @default(uuid()) @db.Uuid
  author_id    String   @db.Uuid
  content      String
  entity_type  String
  entity_id    String   @db.Uuid
  fellowship_id String?  @db.Uuid
  is_internal  Boolean  @default(false)
  created_at   DateTime @default(now())

  @@index([fellowship_id])
  @@map("comments")
}

model LeadershipHistory {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  role_name      String
  department_id  String?   @db.Uuid
  fellowship_id  String?   @db.Uuid
  start_date     DateTime  @default(now())
  end_date       DateTime?
  assigned_by    String?   @db.Uuid

  @@index([fellowship_id])
  @@map("leadership_history")
}

// ---------- Youth & Children ----------
//
// Deliberately does NOT reuse Member for youth/child participants: Member requires
// expected_graduation_year/expected_graduation_month (campus-fellowship semantics that don't
// apply to children) and has no age/guardian concept. YouthProfile.member_id stays nullable+
// unique so an older "youth" who is also a registered adult-style Member can still be linked.
// Programs/meetings/attendance-recording UI intentionally reuse Activity/Attendance as-is
// (no new "program" entity) - see ARCHITECTURE.md's Youth & Children section.

model AgeGroup {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String?  @db.Uuid
  name           String
  min_age        Int
  max_age        Int
  description    String?
  is_active      Boolean  @default(true)
  display_order  Int      @default(0)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  youthProfiles  YouthProfile[]

  @@index([fellowship_id])
  @@map("age_groups")
}

model YouthProfile {
  id             String           @id @default(uuid()) @db.Uuid
  fellowship_id  String?          @db.Uuid
  member_id      String?          @unique @db.Uuid
  full_name      String
  date_of_birth  DateTime
  gender         String?
  age_group_id   String?          @db.Uuid
  department_id  String?          @db.Uuid
  status         MembershipStatus @default(active)
  // Safeguarding-restricted free text; stripped by the service layer for callers without
  // youth.safeguarding_view. See YouthGuardian for guardian relationships.
  notes          String?
  created_by     String           @db.Uuid
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  member         Member?          @relation(fields: [member_id], references: [id], onDelete: SetNull)
  ageGroup       AgeGroup?        @relation(fields: [age_group_id], references: [id], onDelete: SetNull)
  department     Department?      @relation(fields: [department_id], references: [id], onDelete: SetNull)
  guardians      YouthGuardian[]
  attendances    Attendance[]

  @@index([fellowship_id])
  @@index([department_id])
  @@index([age_group_id])
  @@map("youth_profiles")
}

model YouthGuardian {
  id                  String   @id @default(uuid()) @db.Uuid
  fellowship_id       String?  @db.Uuid
  youth_id            String   @db.Uuid
  // Guardians must be an existing fellowship Member (spec: don't create a parallel person table).
  guardian_member_id  String   @db.Uuid
  relationship_type   String
  is_primary          Boolean  @default(false)
  consent_status      String   @default("granted")
  created_by          String   @db.Uuid
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  youth               YouthProfile @relation(fields: [youth_id], references: [id], onDelete: Cascade)
  guardianMember      Member       @relation(fields: [guardian_member_id], references: [id], onDelete: Cascade)

  @@unique([youth_id, guardian_member_id])
  @@index([fellowship_id])
  @@index([guardian_member_id])
  @@map("youth_guardians")
}

// ---------- Member engagement ----------
//
// Sensitive/enrichment data lives in MemberProfile (1:1), NOT as new columns on Member, because
// the existing GET /members endpoints return raw Member rows to department/gender leaders - any
// sensitive column added to Member would leak through them immediately.

model MemberProfile {
  id                              String   @id @default(uuid()) @db.Uuid
  member_id                       String   @unique @db.Uuid
  fellowship_id                   String?  @db.Uuid
  occupation                      String?
  membership_date                 DateTime?
  skills                          String[] @default([])
  interests                       String[] @default([])
  service_interests               String[] @default([])
  preferred_channels              String[] @default([])
  emergency_contact_name          String?
  emergency_contact_phone         String?
  emergency_contact_relationship  String?
  updated_by                      String?  @db.Uuid
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt

  member                          Member   @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([fellowship_id])
  @@map("member_profiles")
}

// Auditable membership timeline. department_id / related_department_id are deliberately plain
// UUID scalars (no FK): history must survive removal of the records it refers to.
model MembershipHistory {
  id                     String              @id @default(uuid()) @db.Uuid
  member_id              String              @db.Uuid
  fellowship_id          String?             @db.Uuid
  event_type             MembershipEventType
  from_status            MembershipStatus?
  to_status              MembershipStatus?
  department_id          String?             @db.Uuid
  related_department_id  String?             @db.Uuid
  reason                 String?
  recorded_by            String?             @db.Uuid
  occurred_at            DateTime            @default(now())

  member                 Member              @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id, occurred_at])
  @@index([fellowship_id, occurred_at])
  @@map("membership_history")
}

model MemberGroup {
  id             String   @id @default(uuid()) @db.Uuid
  fellowship_id  String?  @db.Uuid
  name           String
  description    String?
  is_active      Boolean  @default(true)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  members        MemberGroupMember[]

  @@unique([fellowship_id, name])
  @@map("member_groups")
}

model MemberGroupMember {
  id             String      @id @default(uuid()) @db.Uuid
  group_id       String      @db.Uuid
  member_id      String      @db.Uuid
  fellowship_id  String?     @db.Uuid
  joined_at      DateTime    @default(now())
  added_by       String?     @db.Uuid
  leader_role    String?     // 'male_leader' | 'female_leader'; at most one of each per group (CHECK in the migration)

  group          MemberGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  member         Member      @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([group_id, member_id])
  @@unique([group_id, leader_role])
  @@index([member_id])
  @@index([fellowship_id])
  @@map("member_group_members")
}

// ---------- Backups ----------

model Backup {
  id                 String                @id @default(uuid()) @db.Uuid
  created_by         String                @db.Uuid
  created_at         DateTime              @default(now())
  file_path          String
  file_size          Int
  storage_location   BackupStorageLocation
  status             BackupStatus          @default(success)
  is_incremental     Boolean               @default(false)
  is_safety_backup   Boolean               @default(false)
  restored_from      String?               @db.Uuid

  @@map("backups")
}

// ---------- Notifications ----------

model Notification {
  id                  String   @id @default(uuid()) @db.Uuid
  recipient_user_id   String   @db.Uuid
  event_type          String
  title                String
  message              String
  entity_type          String?
  entity_id            String?  @db.Uuid
  is_read              Boolean  @default(false)
  actor_user_id        String?  @db.Uuid
  fellowship_id        String?  @db.Uuid
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  actor                User?    @relation("NotificationActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([recipient_user_id, is_read, created_at])
  @@index([fellowship_id])
  @@map("notifications")
  // Foreign key without an index (found in the Phase 22 database review): a join or a parent delete scanned the whole table.
  @@index([actor_user_id])
}

// ---------- Audit & System ----------

model AuditLog {
  id                          String   @id @default(uuid()) @db.Uuid
  user_id                     String?  @db.Uuid
  action                      String
  entity_type                 String?
  entity_id                   String?  @db.Uuid
  timestamp                   DateTime @default(now())
  old_value                   Json?
  new_value                   Json?
  ip_address                  String?
  device_info                 String?
  approval_info               Json?
  comment                     String?
  impersonation_session_id    String?  @db.Uuid
  // The tenant the entry belongs to (the actor's fellowship, or the fellowship a platform action was taken on).
  // Null for platform-level entries. Tenant audit views filter on it.
  fellowship_id               String?  @db.Uuid

  @@index([timestamp])
  @@index([user_id])
  @@index([fellowship_id, timestamp])
  @@map("audit_logs")
}

model ImpersonationSession {
  id              String              @id @default(uuid()) @db.Uuid
  admin_user_id   String              @db.Uuid
  target_user_id  String              @db.Uuid
  approval_token  String
  status          ImpersonationStatus @default(requested)
  requested_at    DateTime            @default(now())
  approved_at     DateTime?
  started_at      DateTime?
  expires_at      DateTime?
  ended_at        DateTime?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  // Why the platform needed to act as this person, and who they acted as. Both are kept on the record so the
  // fellowship can be told afterwards even if the account is later removed. The client's own identity is never
  // stored here beyond the target id, and `approval_token` is unused while approval is not required - it is
  // kept for the one-time-code step, which needs no schema change.
  reason          String?
  target_email    String?
  fellowship_id   String?             @db.Uuid
  revoked_at      DateTime?
  ended_by        String?             @db.Uuid
  end_reason      String?

  @@index([admin_user_id, status])
  @@index([target_user_id, status])
  @@index([fellowship_id, status])
  @@index([expires_at])
  @@map("impersonation_sessions")
}

model DeletedRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  original_collection  String
  original_record_id   String   @db.Uuid
  original_data        Json
  deleted_by           String   @db.Uuid
  deleted_at           DateTime @default(now())
  restore_token        String   @unique
  // The fellowship the deleted record belonged to. Missing before Phase 22, which let any secretary list, discard
  // or "restore" every fellowship's deleted records.
  fellowship_id        String?  @db.Uuid
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([deleted_at])
  @@index([fellowship_id, deleted_at])
  @@map("deleted_records")
}

// ---------- Public sites ----------

// The fellowship's own identity on its public site: the name shown in the header, the story on "About Us", and the
// ways a visitor can reach it. Separate from `fellowships` on purpose - the operational record is the platform's
// business, this is marketing copy the IT administrator owns, and editing one must never disturb the other.
model PublicProfile {
  fellowship_id String @db.Uuid
  tagline       String?
  story         String?  // "About Us" body
  mission       String?
  vision        String?
  // Contact details a visitor can use. Deliberately nullable: a fellowship that has not published an address yet
  // simply shows no address, and the page falls back to the platform's own "get started" route.
  email         String?
  phone         String?
  address       String?
  service_times String?
  facebook_url  String?
  youtube_url   String?
  whatsapp_url  String?
  updated_by    String?  @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  fellowship Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@id([fellowship_id])
  @@map("public_profiles")
}

// The editable introduction of one landing page - the heading and paragraph above the list. The list itself is
// read from the operational tables (departments, programmes, events, news), so publishing a department on the
// landing page needs no second copy of it here.
enum PublicPageKey {
  home
  about
  leadership
  departments
  ministries
  events
  publications
  news
  gallery
  sermons
  testimonies
  projects
  get_involved
  prayer
  give
  contact
}

model PublicPage {
  fellowship_id String        @db.Uuid
  key          PublicPageKey
  title        String
  subtitle     String?
  body         String?
  // A page may be hidden from the navigation without its content being deleted (e.g. a fellowship that does not
  // run a gallery yet). The route still resolves, so an old link does not 404.
  is_visible   Boolean       @default(true)
  updated_by   String?       @db.Uuid
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  fellowship Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@id([fellowship_id, key])
  @@map("public_pages")
}

// Editorial items the operational tables have no home for: a sermon, a testimony, a project. One table with a
// discriminator rather than three, because they are edited, ordered and unpublished identically.
enum PublicPostKind {
  sermon
  testimony
  project
}

model PublicPost {
  id            String         @id @default(uuid()) @db.Uuid
  fellowship_id String         @db.Uuid
  kind          PublicPostKind
  title         String
  body          String?
  reference     String?        // scripture or scripture reference, for a sermon
  attribution   String?        // who said it, for a testimony
  media_url     String?
  // When the sermon was preached or the project happened. Null means "not a dated item", which sorts last.
  happens_at    DateTime?
  // Publication is explicit and off by default: an item is written first and only becomes visible once somebody
  // with permission publishes it, so a draft can never leak onto the public site.
  is_published  Boolean        @default(false)
  sort_order    Int            @default(0)
  created_by    String         @db.Uuid
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  fellowship Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@index([fellowship_id, kind, is_published])
  @@map("public_posts")
}

// Anything a visitor sends through the public site: a prayer request, a contact message, or an intent to give.
// Stored so the fellowship can actually read and answer it. There is no payment gateway, so `donation_pledge`
// records an intention and an amount only - it never claims money was received.
enum PublicEnquiryKind {
  prayer_request
  contact_message
  donation_pledge
}

model PublicEnquiry {
  id            String           @id @default(uuid()) @db.Uuid
  fellowship_id String           @db.Uuid
  kind          PublicEnquiryKind
  name          String
  email         String?
  phone         String?
  message       String
  amount        Decimal?         @db.Decimal(12, 2)
  currency      String?          @default("USD")
  // There is deliberately NO "is_private" flag. An earlier version had one that the client set, which meant any
  // visitor could mark a prayer request publishable; nothing ever read it publicly, so it was a promise the code
  // did not keep. A prayer request is private because there is no public route that can reach one - the content
  // manager's inbox is the only reader, and it is behind the tenant check.
  is_handled    Boolean          @default(false)
  handled_by    String?          @db.Uuid
  handled_at    DateTime?
  submitted_ip  String?
  created_at    DateTime         @default(now())

  fellowship Fellowship @relation(fields: [fellowship_id], references: [id], onDelete: Cascade)

  @@index([fellowship_id, kind, created_at])
  @@index([fellowship_id, is_handled])
  @@map("public_enquiries")
}
