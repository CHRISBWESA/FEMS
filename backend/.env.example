# Database (local PostgreSQL 18 instance)
DATABASE_URL="postgresql://postgres:Bwesa%402213@127.0.0.1:5432/fems_dev"

# Authentication
JWT_SECRET="dev-only-change-this-to-a-very-long-random-string-min-64-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Rate Limiting (Redis)
# The general limit must cover ordinary UI navigation: the client re-reads /profile on every route change,
# so a limit of a few hundred per hour made normal use return 429. 600/minute matches the code default.
# The tighter limits that guard sign-in and public endpoints live in AUTH_/PUBLIC_RATE_LIMIT_*.
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR="./uploads"
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,txt"

# Cloudinary Storage
CLOUDINARY_URL="cloudinary://698316294846183:8uV1hr6Ogrv-dKJmqCtlRIJRVrU@dyyiogtro"
CLOUDINARY_CLOUD_NAME="dyyiogtro"
CLOUDINARY_API_KEY="698316294846183"
CLOUDINARY_API_SECRET="8uV1hr6Ogrv-dKJmqCtlRIJRVrU"

# Backup
BACKUP_INTERVAL_HOURS=12
BACKUP_DIR="./backups"
BACKUP_CLOUD_ENABLED=false
BACKUP_CLOUD_PROVIDER=""
BACKUP_CLOUD_BUCKET=""
BACKUP_CLOUD_ENDPOINT=""
BACKUP_CLOUD_ACCESS_KEY=""
BACKUP_CLOUD_SECRET_KEY=""
BACKUP_RETENTION_DAYS=30