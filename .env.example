# Backend development environment
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
DATABASE_FORCE_UTC_SESSION=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30
UPLOAD_MAX_SIZE=10485760
BILLING_WEBHOOK_SECRET=
SEED_ADMIN_PASSWORD=
TEST_DATABASE_URL=

# --- Future provider integrations (activate when you have an account) ---
# Bulk SMS (#4) and LLM contribution reminders (#5) need an SMS provider key.
# Rejected-request reminders (#2) need an email transport plus an SMS/WhatsApp
# channel. Until these are set, the relevant UI records intent and status
# "pending" and does not claim delivery.
SMS_PROVIDER_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM=

# Frontend development environment
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Future provider integrations, scaffolded for later activation ------------
# These are intentionally blank. When you are ready to enable real delivery for
# bulk SMS (Req #4), contribution reminders (Req #5) and rejected-request /
# registration notifications (Req #2), add a provider account and fill these:
#
#   SMS  — e.g. http://<provider base url> and the machine-to-machine key
#   EMAIL — an SMTP provider or a transactional API
#   WHATSAPP — a WhatsApp Business sender
#
# The app will record intent and status as "pending" until a provider is wired,
# and never claim to have delivered without one.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_FROM=
